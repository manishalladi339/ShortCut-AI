# Local development
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001

# Google sign-in is hidden unless the current platform has a client ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Public legal/support identity. Set real values before public launch.
EXPO_PUBLIC_LEGAL_OPERATOR_NAME=
EXPO_PUBLIC_SUPPORT_EMAIL=

# Production example:
# EXPO_PUBLIC_BACKEND_URL=https://api.shortcut.example
