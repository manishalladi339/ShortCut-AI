MONGO_URL=mongodb://localhost:27017
DB_NAME=shortcut_ai

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALG=HS256
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=30

APP_PUBLIC_URL=http://localhost:8001

# local | s3
STORAGE_BACKEND=local
STUB_STORAGE_DIR=/tmp/shortcut_storage

# Required only for STORAGE_BACKEND=s3
S3_BUCKET=
AWS_REGION=ap-south-1
S3_ENDPOINT_URL=

FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
MEDIA_PROBE_TIMEOUT_SEC=30
MEDIA_DERIVATIVE_TIMEOUT_SEC=180
RENDER_TIMEOUT_SEC=900
WORKER_POLL_INTERVAL_SEC=1.0
MEDIA_INTELLIGENCE_TIMEOUT_SEC=900
SCENE_DETECTION_THRESHOLD=0.35

TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=whisper-1
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

STRIPE_PAID_PLANS_ENABLED=false
