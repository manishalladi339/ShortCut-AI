MONGO_URL=mongodb://localhost:27017
DB_NAME=shortcut_ai

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALG=HS256
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=30

APP_PUBLIC_URL=http://localhost:8001

# local | s3
STORAGE_BACKEND=local
STUB_STORAGE_DIR=/tmp/shortcut_storage

# Required only for STORAGE_BACKEND=s3
S3_BUCKET=
AWS_REGION=ap-south-1
S3_ENDPOINT_URL=

FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
MEDIA_PROBE_TIMEOUT_SEC=30
MEDIA_DERIVATIVE_TIMEOUT_SEC=180
RENDER_TIMEOUT_SEC=900
AUDIO_MASTERING_ENABLED=true
AUDIO_TARGET_LUFS=-14.0
AUDIO_TRUE_PEAK_DBTP=-1.5
AUDIO_TARGET_LRA=11.0
WORKER_POLL_INTERVAL_SEC=1.0
# Lease must exceed the longest single blocking worker step. Expired leases are recovered.
JOB_LEASE_SECONDS=1200
MEDIA_INTELLIGENCE_TIMEOUT_SEC=900
SCENE_DETECTION_THRESHOLD=0.35
SILENCE_NOISE_DB=-35
SILENCE_MIN_DURATION_SEC=0.35
SILENCE_SNAP_WINDOW_SEC=0.75
RHYTHM_WINDOW_MS=50
RHYTHM_BASELINE_SEC=0.4
RHYTHM_ENERGY_RATIO=1.8
RHYTHM_MIN_RMS=300
RHYTHM_MIN_INTERVAL_SEC=0.25

TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
VISION_PROVIDER=openai
VISION_MODEL=gpt-4o
MAX_VISION_FRAMES=8
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
NARRATIVE_PROVIDER=deterministic
NARRATIVE_MODEL=gpt-5-mini
AI_PLANNER_TIMEOUT_SEC=120
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

STRIPE_PAID_PLANS_ENABLED=false
