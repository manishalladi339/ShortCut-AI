# Copy to .env.production and replace every placeholder before deployment.
ENVIRONMENT=production
LOG_LEVEL=INFO

# Public HTTPS API origin and exact frontend origins allowed by CORS.
APP_PUBLIC_URL=https://api.shortcut.example
CORS_ORIGINS=https://app.shortcut.example

# External MongoDB (Atlas or equivalent). Do not use a container-local Mongo in production.
MONGO_URL=mongodb+srv://USER:PASSWORD@HOST/shortcut_ai?retryWrites=true&w=majority
DB_NAME=shortcut_ai
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_48_PLUS_CHAR_RANDOM_SECRET
JWT_ALG=HS256
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=30

# Shared object storage required by API and every worker.
STORAGE_BACKEND=s3
S3_BUCKET=shortcut-production
AWS_REGION=ap-south-1
S3_ENDPOINT_URL=
# Prefer workload/instance identity. Set static credentials only when your host requires them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
MEDIA_PROBE_TIMEOUT_SEC=30
MEDIA_DERIVATIVE_TIMEOUT_SEC=180
RENDER_TIMEOUT_SEC=900
MEDIA_INTELLIGENCE_TIMEOUT_SEC=900
WORKER_POLL_INTERVAL_SEC=1.0
JOB_LEASE_SECONDS=1200

AUDIO_MASTERING_ENABLED=true
AUDIO_TARGET_LUFS=-14.0
AUDIO_TRUE_PEAK_DBTP=-1.5
AUDIO_TARGET_LRA=11.0

SCENE_DETECTION_THRESHOLD=0.35
SILENCE_NOISE_DB=-35
SILENCE_MIN_DURATION_SEC=0.35
SILENCE_SNAP_WINDOW_SEC=0.75
RHYTHM_WINDOW_MS=50
RHYTHM_BASELINE_SEC=0.4
RHYTHM_ENERGY_RATIO=1.8
RHYTHM_MIN_RMS=300
RHYTHM_MIN_INTERVAL_SEC=0.25

TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
VISION_PROVIDER=openai
VISION_MODEL=gpt-4o
MAX_VISION_FRAMES=8
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
NARRATIVE_PROVIDER=deterministic
NARRATIVE_MODEL=gpt-5-mini
AI_PLANNER_TIMEOUT_SEC=120
OPENAI_API_KEY=REPLACE_WITH_PROVIDER_KEY
OPENAI_API_BASE=https://api.openai.com/v1

# Paid billing remains disabled for the production beta unless Stripe is explicitly wired.
STRIPE_PAID_PLANS_ENABLED=false
