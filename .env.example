# Docker Compose: copy this file to .env and configure your deployment.
APP_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
APP_PUBLIC_URL=http://localhost:8080
FRONTEND_PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:8081
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_REGION=ap-south-1
# Prefer an instance/task role for S3 rather than checked-in credentials.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
# Optional for editing, required for password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
